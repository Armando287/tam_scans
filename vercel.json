{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "env": {
    "HF_AWS_ACCESS_KEY_ID": "@hf_aws_access_key_id",
    "HF_AWS_SECRET_ACCESS_KEY": "@hf_aws_secret_access_key",
    "HF_S3_ENDPOINT": "@hf_s3_endpoint",
    "HF_S3_BUCKET": "@hf_s3_bucket",
    "FIREBASE_ADMIN_PROJECT_ID": "@firebase_admin_project_id",
    "FIREBASE_ADMIN_CLIENT_EMAIL": "@firebase_admin_client_email",
    "FIREBASE_ADMIN_PRIVATE_KEY": "@firebase_admin_private_key"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS,DELETE,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type" }
      ]
    }
  ]
}
